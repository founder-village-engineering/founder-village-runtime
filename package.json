{
  "name": "founder-village-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "services/admin-web"
  ],
  "scripts": {
    "start": "bin/fv start",
    "build": "tsc -p tsconfig.json && npm run build -w services/admin-web",
    "typecheck": "tsc --noEmit && npm run typecheck -w services/admin-web",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node --env-file=.state/local.env --import tsx tests/integration.ts",
    "test:browser": "playwright test",
    "test:browser:https": "FV_BROWSER_LOCAL_HTTPS=1 playwright test",
    "check": "npm run frontend-contracts:validate && npm run typecheck && npm test && npm run build",
    "api": "tsx services/api/main.ts",
    "admin": "tsx services/admin-api/main.ts",
    "workers": "tsx services/workers/main.ts",
    "migrate": "tsx packages/database/migrate.ts",
    "hasura": "tsx scripts/hasura.ts",
    "team:login": "node --env-file=.state/local.env --import tsx scripts/team-login.ts",
    "local:seed": "tsx scripts/seed.ts",
    "security:scan": "node scripts/security-scan.ts",
    "release:local": "node scripts/local-release.ts",
    "release:rules": "node scripts/github-release-rules.ts",
    "uptime:install": "node scripts/install-uptime.ts",
    "release:verify": "node scripts/release-verify.ts",
    "namespace:add": "node --import tsx scripts/onboard.ts",
    "frontend:add": "node --import tsx scripts/onboard-frontend.ts",
    "frontend:production": "node --import tsx scripts/frontend-production.ts",
    "production:bootstrap": "node scripts/production-entry.ts",
    "production:enroll-hetzner": "node --import tsx scripts/production/enroll-hetzner.ts",
    "production:vault": "node --import tsx scripts/production/vaultwarden.ts",
    "backup:pull": "node --import tsx scripts/workstation-backup.ts pull",
    "backup:verify": "node --import tsx scripts/workstation-backup.ts verify",
    "backup:schedule": "node --import tsx scripts/workstation-backup-install.ts",
    "hasura:generate": "node --import tsx scripts/generate-hasura.ts",
    "frontend-contracts:validate": "node --import tsx scripts/sync-frontend-contracts.ts --validate",
    "frontend-contracts:check": "node --import tsx scripts/sync-frontend-contracts.ts --check",
    "frontend-contracts:sync": "node --import tsx scripts/sync-frontend-contracts.ts --write",
    "frontend-contracts:watch": "node --import tsx scripts/sync-frontend-contracts.ts --watch",
    "format:check": "prettier --check \"packages/**/*.ts\" \"services/**/*.{ts,tsx,css,html,json}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"config/*.json\" \"hasura/**/*.json\" \"policies/*.json\" \".github/**/*.yml\" playwright.config.ts",
    "format": "prettier --write \"packages/**/*.ts\" \"services/**/*.{ts,tsx,css,html,json}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"config/*.json\" \"hasura/**/*.json\" \"policies/*.json\" \".github/**/*.yml\" playwright.config.ts",
    "security:admin": "NODE_EXTRA_CA_CERTS=.state/local/edge/root.crt node --use-system-ca --env-file=.state/local.env --import tsx scripts/red-blue-admin.ts",
    "test:browser:team": "npm --prefix ../founder-village-frontends run pages -- plan --app founder-village-team && mkdir -p .state/team-browser-dist && cp -R ../founder-village-frontends/apps/founder-village-team/dist/. .state/team-browser-dist/ && playwright test --config tests/team-browser/playwright.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@solana/addresses": "8.6.0",
    "amqplib": "2.4.0",
    "bs58": "6.0.0",
    "cf": "1.0.0-rc.0",
    "fastify": "5.12.8",
    "graphql": "16.15.0",
    "jose": "6.2.17",
    "libpg-query": "17.8.3",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "stripe": "23.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/amqplib": "0.10.8",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
