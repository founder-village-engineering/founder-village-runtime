{
  "repository": "founder-village-engineering/founder-village-runtime",
  "rulesets": [
    {
      "name": "Founder Village release branch",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": {
        "ref_name": {
          "include": ["refs/heads/main"],
          "exclude": []
        }
      },
      "rules": [{ "type": "deletion" }, { "type": "non_fast_forward" }]
    },
    {
      "name": "Founder Village immutable release tags",
      "target": "tag",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": {
        "ref_name": {
          "include": ["refs/tags/v*.*.*"],
          "exclude": []
        }
      },
      "rules": [{ "type": "deletion" }, { "type": "update" }]
    }
  ]
}
